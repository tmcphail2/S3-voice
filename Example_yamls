  #      - switch.turn_on: reboot_switch


# LCD Backlight
output:
  - platform: ledc
    pin: GPIO38
    id: bl_pwm
    frequency: 1000Hz     # or try 5000Hz if still dim


light:
  - platform: monochromatic
    output: bl_pwm
    id: lcd_backlight
    restore_mode: ALWAYS_ON
    default_transition_length: 0s

