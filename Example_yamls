    size: 16

  - file: "gfonts://Roboto"
    id: roboto_24
    size: 24

  - file: "gfonts://Roboto"
    id: roboto_36
    size: 36

color:
  - id: rgb_black
    red: 0%
    green: 0%
    blue: 0%
  - id: rgb_white
    red: 100%
    green: 100%
    blue: 100%
  - id: rgb_blue
    red: 0%
    green: 0%
    blue: 100%
  - id: rgb_red
    red: 100%
    green: 0%
    blue: 0%
  - id: rgb_green
    red: 0%
    green: 100%
    blue: 0%
  - id: rgb_yellow
    red: 100%
    green: 100%
    blue: 0%
  - id: rgb_orange
    red: 100%
    green: 50%
    blue: 0%


sensor:
  - platform: uptime
    name: "Uptime"  


display:
  - platform: mipi_spi
    id: lcd_display
    update_interval: never
    model: ST7789P
    spi_id: lcd_spi
    cs_pin: GPIO41
    dc_pin: GPIO45
    reset_pin: GPIO21
    init_sequence: []
    invert_colors: true

    # portrait
    dimensions:
      width: 135
      height: 240
      offset_width: 52
      offset_height: 40

    # landscape
    #transform:
    #  swap_xy: true
    #  mirror_x: true
    #  mirror_y: false
    #dimensions:
    #  width: 240
    #  height: 135
    #  offset_width: 40
    #  offset_height: 53

    lambda: |-
      // Turn the whole display on
      it.fill(rgb_black);
      it.rectangle(0, 0, 240, 135, rgb_blue);
      if (id(ha_time).now().is_valid()) {
        it.strftime(5, 0, id(roboto_16), Color(rgb_yellow), "%d.%m.%Y %H:%M:%S %Z", id(ha_time).now()); 
      }


interval:
  - interval: 10s
    id: refresh_pm1
    then:
      - lambda: |
          auto pm1 = id(m5pm1_id);
          pm1->trigger_update();
          ESP_LOGD("log_pm1", "Battery: %.1fV", id(m5pm1_battery_volt).state);

