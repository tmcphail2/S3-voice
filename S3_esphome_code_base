# built using HA esphome app, compiles fine but display doesnt work 9/18/26
# Board: ESP32-S3 DevKitC-1 (Espressif)
# Definition: definitions/boards/esp32-s3-devkitc-1/manifest.yaml

esphome:
  name: m5stack-stick-s3
  friendly_name: M5Stack Stick S3

esp32:
  variant: esp32s3
  flash_size: 8MB
  framework:
    type: esp-idf

logger:

api:
  encryption:
    key: "IjnzXuKhuVM0EmhMa9JHRpkqDLEG5bIoSkn5ztrV48g="

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: M5Stack Stick S Fallback Hotspot
    password: "v3nrwA5FIIDv"

captive_portal:

spi:
  clk_pin: GPIO40
  mosi_pin: GPIO39
 # miso_pin: GPIO18 # Unused but often required by ESPHome validation

binary_sensor:
  - platform: gpio
    pin:
      number: 11
      inverted: true
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on: 10ms
      - delayed_off: 10ms
    name: "M5Stack Main Button"
    id: main_button

  - platform: gpio
    pin:
      number: 12
      inverted: true
      mode:
        input: true
        pullup: true
    filters:
      - delayed_on: 10ms
      - delayed_off: 10ms
    name: "M5Stack Side Button"
    id: side_button
    
display:
  - platform: st7789v
    model: TTGO TDisplay 135x240
    backlight_pin: GPIO38
    cs_pin: GPIO41
    dc_pin: GPIO45
    reset_pin: GPIO21
    rotation: 0
    id: m5_screen
    lambda: |-
      it.print(0, 0, id(my_font), "ESPHome Ready!");

font:
  - file: "gfonts://Roboto"
    id: my_font
    size: 20
